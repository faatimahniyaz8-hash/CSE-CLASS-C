
#include <stdio.h>
#include <string.h>
void uppercase(char word[],int n){
    for(int i=0;i<n;i++){
        char ch=word[i];
        if(ch>='A' && ch<='Z'){
            continue;
        }else{
            int pos=ch-'a';
            word[i]='A' +pos;
            }
    }
}  

int main()
{ 
    char word[]="ApPle";
    uppercase(word,strlen(word));
    printf("%s",word);
  return 0;}
